@article{choi2026matthew,
  abbr={JOI},
  title={Does the Matthew Effect Exist in Open Peer Review? An Empirical Study of Institutional Prestige Effects on Review Outcomes},
  author={Jeongyeon Choi, Yi Zhao, Yongjun Zhu},
  abstract={The phenomenon of cumulative advantage, known as the Matthew Effect, has been extensively observed in the scientific community. However, less is known about how cumulative advantage manifests through institutional prestige during the evaluative phase of open peer review (OPR). In this study, we investigate whether authors’ institutional prestige influences review outcomes in OPR and, if so, the extent of that influence. Examining all research and review articles published on the open-access publishing platform F1000Research from 2012 to 2025, we assess the effects of institutional prestige on OPR review outcomes using coarsened exact matching (CEM). To isolate the effect of institutional prestige, we controlled for authors’ scholarly impact using the h-index and article-level differences using measures of novelty and readability. The results indicate that (1) institutional prestige is positively associated with peer review evaluations, (2) its effects vary across review criteria, (3) it leads to shorter review periods, and (4) its effects weaken as authors accumulate greater scholarly impact. This study advances the scholarly understanding of the Matthew Effect in OPR and devises recommendations for reviewers, editors, and policymakers.},
  journal={Journal of Informetrics},
  volume={20},
  number={3},
  pages={000--000},
  year={2026},
  month={September},
  publisher={Elsevier},
  doi={10.1103/PhysRev.47.777},
  html={https://journals.aps.org/pr/abstract/10.1103/PhysRev.47.777},
  selected={true}
}
