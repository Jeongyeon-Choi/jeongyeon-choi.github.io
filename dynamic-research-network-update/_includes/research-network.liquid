{% assign network_papers = site.data.research_network.papers %}
{% assign network_topics = network_papers | map: 'topic' | uniq %}
{% assign network_years = network_papers | map: 'year' | sort %}
<section class="academic-section research-network" aria-labelledby="network-heading" data-research-network>
  <div class="academic-section-heading">
    <h2 id="network-heading">Research connections</h2>
    <span class="network-count">{{ network_papers | size }} publications · {{ network_years.first }}{% if network_years.last != network_years.first %}–{{ network_years.last }}{% endif %}</span>
  </div>
  <p class="network-introduction">A network of my publications and their research areas.</p>

  <div class="network-explorer">
    <div class="network-canvas" hidden>
      <div class="network-tools">
        <p>Drag nodes to rearrange. Select a paper to read more.</p>
        <button type="button" class="network-reset">Reset layout</button>
      </div>
      <p class="sr-only" id="network-keyboard-help">Use arrow keys to move a focused node. Press Enter to select a paper or cycle through papers in a research area. Reset layout restores all positions.</p>
      <svg class="network-svg" viewBox="0 0 700 580" role="group" aria-label="Jeongyeon Choi connected to {{ network_papers | size }} publications and their research areas">
        <g class="network-edges" aria-hidden="true">
          {% for paper in network_papers %}
            <path class="network-authorship" data-paper="{{ paper.id }}" data-topic="{{ paper.topic | escape }}" />
            <path class="network-topic-edge" data-paper="{{ paper.id }}" data-topic="{{ paper.topic | escape }}" />
          {% endfor %}
        </g>
        <g class="network-ego network-movable" tabindex="0" role="img" aria-label="Jeongyeon Choi; use arrow keys to move" aria-describedby="network-keyboard-help">
          <circle class="network-ego-halo" r="47" />
          <circle class="network-ego-core" r="34" />
          <text class="network-initials" y="6" text-anchor="middle" aria-hidden="true">JC</text>
          <text class="network-person" y="-70" text-anchor="middle">Jeongyeon <tspan font-weight="700">Choi</tspan></text>
          <text class="network-role" y="-49" text-anchor="middle">Researcher</text>
        </g>
        {% for paper in site.data.research_network.papers %}
          <g class="network-paper network-movable" data-paper="{{ paper.id }}" data-topic="{{ paper.topic | escape }}" role="button" tabindex="0" aria-pressed="false" aria-label="Explore {{ paper.short_title | escape }} ({{ paper.year }})" aria-describedby="network-keyboard-help" aria-controls="network-detail-{{ paper.id }}">
            <rect class="network-hit-area" x="-90" y="-76" width="180" height="110" rx="8" />
            <circle class="network-paper-ring" r="27" />
            <circle class="network-paper-dot" r="19" />
            <title>{{ paper.title | escape }}</title>
            <text class="network-node-year" text-anchor="middle" y="-58">{{ paper.year }}</text>
            <text class="network-node-title" text-anchor="middle" y="-38">{{ paper.short_title | escape }}</text>
            {% if paper.graph_subtitle %}<text class="network-node-subtitle" text-anchor="middle" y="-20">{{ paper.graph_subtitle | escape }}</text>{% endif %}
          </g>
        {% endfor %}
        {% for topic in network_topics %}
          {% assign topic_paper = network_papers | where: 'topic', topic | first %}
          <g class="network-topic network-movable" data-topic="{{ topic | escape }}" tabindex="0" role="button" aria-label="Explore {{ topic | escape }} publications" aria-describedby="network-keyboard-help">
            <circle class="network-topic-hit" r="24" />
            <circle class="network-topic-dot" r="10" />
            <text text-anchor="middle" y="30">{% for line in topic_paper.topic_lines %}<tspan x="0" dy="{% if forloop.first %}0{% else %}18{% endif %}">{{ line }}</tspan>{% endfor %}</text>
          </g>
        {% endfor %}
      </svg>
      <div class="network-legend" aria-label="Connection types">
        <span><i class="network-legend-solid" aria-hidden="true"></i>Authorship</span>
        <span><i class="network-legend-dashed" aria-hidden="true"></i>Research area</span>
      </div>
    </div>

    <div class="network-details" aria-live="polite" aria-atomic="true">
      {% for paper in site.data.research_network.papers %}
        <article class="network-detail" id="network-detail-{{ paper.id }}" data-paper="{{ paper.id }}">
          <p class="network-detail-kicker">Publication · {{ paper.year }}</p>
          <h3>{{ paper.title }}</h3>
          <p class="network-authors">{{ paper.authors }}</p>
          <p class="network-venue">{{ paper.venue }}</p>
          {% if paper.status %}<p class="network-summary network-status">{{ paper.status }}</p>{% endif %}
          <p class="network-summary">{{ paper.summary }}</p>
          <p class="network-topic-label">{{ paper.topic }}</p>
          <div class="network-detail-links">
            <a href="{{ '/publications/' | relative_url }}#{{ paper.id }}">Publication details <span aria-hidden="true">&rarr;</span></a>
            {% if paper.doi %}<a href="{{ paper.doi }}">DOI <span aria-hidden="true">↗</span></a>{% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
  <div class="network-paper-picker" role="group" aria-label="Select a publication" hidden>
    {% for paper in site.data.research_network.papers %}
      <button type="button" data-paper="{{ paper.id }}" aria-pressed="false" aria-controls="network-detail-{{ paper.id }}">{{ paper.short_title | escape }} · {{ paper.year }}</button>
    {% endfor %}
  </div>
</section>
<script defer src="{{ '/assets/js/research-network.js' | relative_url | bust_file_cache }}"></script>
